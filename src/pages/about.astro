---
import education from "../collections/education.json";
import experiences from "../collections/experiences.json";
import AboutExperience from "../components/about-experience.astro";
import PageHeading from "../components/page-heading.astro";
import Layout from "../layouts/main.astro";

const initials = (name: string) =>
  name
    .split(" ")
    .map((word) => word[0])
    .join("");
---

<Layout title="About Me">
  <section class="relative z-20 my-12">
    <PageHeading
      title="About Me"
      description="Software Engineer passionate about building applications that solve complex business problems."
    />
    <p
      class="mt-4 text-sm leading-6 text-neutral-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      I specialize in designing cloud-native systems, modernizing legacy
      architectures and leading engineering teams to deliver efficient and
      scalable solutions.
    </p>
    <p
      class="mt-4 text-sm leading-6 text-neutral-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      Always curious, constantly building and driven by continuous learning.
    </p>

    <h2
      class="mt-12 mb-5 text-2xl font-bold text-neutral-900 dark:text-neutral-100"
    >
      Experience
    </h2>
    <div class="space-y-5">
      {experiences.map((experience) => <AboutExperience {...experience} />)}
    </div>

    <h2
      class="mt-12 mb-5 text-2xl font-bold text-neutral-900 dark:text-neutral-100"
    >
      Education
    </h2>
    <div class="grid gap-5 sm:grid-cols-2">
      {
        education.map((item) => (
          <div class="flex flex-col p-6 border rounded-2xl border-neutral-300 dark:border-neutral-700">
            <div class="flex items-center justify-center w-12 h-12 mb-4 text-sm font-semibold border border-dashed rounded-full text-neutral-700 border-neutral-300 dark:text-neutral-200 dark:border-neutral-700">
              {initials(item.school)}
            </div>
            <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">
              {item.school}
            </h3>
            <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-300">
              {item.degree}, {item.field}
            </p>
            <p class="pt-3 mt-auto text-sm font-medium text-neutral-500 dark:text-neutral-400">
              {item.start} – {item.end}
            </p>
          </div>
        ))
      }
    </div>

    <h2
      class="mt-12 mb-2 text-2xl font-bold text-neutral-900 dark:text-neutral-100"
    >
      Let's Connect
    </h2>
    <p
      class="text-sm leading-6 text-neutral-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      Find me on <a
        href="https://www.linkedin.com/in/harish-kurma-9083b7149/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-indigo-600 underline dark:text-indigo-400">LinkedIn</a
      > or <a
        href="https://github.com/hkurma"
        target="_blank"
        rel="noopener noreferrer"
        class="text-indigo-600 underline dark:text-indigo-400">GitHub</a
      >.
    </p>
  </section>
</Layout>
