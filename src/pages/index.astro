---
import Button from "../components/button.astro";
import Layout from "../layouts/main.astro";
---

<Layout title="Harish Kurma">
  <div
    class="relative z-20 flex items-center justify-center flex-1 w-full py-8"
  >
    <div class="flex flex-col items-center w-full md:flex-row">
      <div class="relative w-full md:w-1/2">
        <p
          class="mb-2 text-xl font-medium md:text-2xl text-neutral-500 dark:text-neutral-400"
        >
          Hello,
        </p>
        <h1
          class="mb-5 text-4xl font-bold leading-none tracking-tight text-neutral-900 whitespace-nowrap lg:text-6xl dark:text-white"
        >
          I'm Harish Kurma
        </h1>
        <p
          class="mb-3 text-xl font-medium leading-snug text-neutral-600 md:text-2xl dark:text-neutral-400"
        >
          Software Engineer by Profession<br class="hidden sm:block" /> and Passion.
        </p>
        <Button text="About Me →" link="/about" />
      </div>
      <div
        class="relative justify-end hidden w-full mt-10 md:flex md:pl-10 md:w-1/2 md:mt-0 md:translate-y-4 xl:translate-y-0"
      >
        <div class="relative z-50 w-full">
          <div
            class="absolute bottom-0 z-40 w-16 h-16 -translate-x-6 -translate-y-1/2 lg:top-auto top-0 lg:bottom-[60%] lg:translate-y-0 rounded-full"
          >
            <span
              class="relative z-20 flex items-center justify-center w-full h-full text-2xl border-8 border-white rounded-full dark:border-neutral-950 bg-neutral-100 dark:bg-neutral-900"
            >
              <span
                class="flex items-center justify-center w-full h-full bg-white border border-dashed rounded-full dark:bg-neutral-950 border-neutral-300 dark:border-neutral-700"
                >👋</span
              >
            </span>
          </div>
          <div class="relative z-30 px-10">
            <img
              src="/assets/images/photo.png"
              loading="eager"
              decoding="auto"
              class="relative z-30 w-full aspect-[790/1189] mx-auto object-contain md:max-w-md md:max-h-[calc(100dvh-14rem)] dark:-translate-y-0.5"
            />
          </div>
          <div
            class="absolute bottom-0 right-0 z-20 w-full h-full lg:h-3/4 translate-x-0 -translate-y-px border border-dashed rounded-2xl bg-gradient-to-r dark:from-neutral-950 dark:via-black dark:to-neutral-950 from-white via-neutral-50 to-white border-neutral-300 dark:border-neutral-700"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
